{
  "name": "inventory-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.7.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage && node scripts/filter-coverage.js",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all-browsers": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:invoice-settings": "playwright test tests/e2e/invoice-settings.spec.ts --project=chromium",
    "test:e2e:invoice-settings:all-browsers": "playwright test tests/e2e/invoice-settings.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "type-check": "tsc --noEmit",
    "check:migrations": "node scripts/check-active-migrations.js",
    "staging:guard": "tsx scripts/staging/env-guard-cli.ts",
    "staging:verify-migrations": "tsx scripts/staging/verify-migration-set.ts",
    "staging:audits": "bash scripts/staging/run-pr58-audits.sh",
    "test:staging-guard": "jest --runInBand tests/integration/staging/env-guard.test.ts",
    "check:staging-ref-hardcodes": "tsx scripts/staging/assert-no-hardcoded-project-refs.ts",
    "test:auth-matrix": "jest --runInBand tests/integration/auth-matrix/matrix.test.ts",
    "test:production-guards": "jest --runInBand tests/integration/production/db-deploy-guards.test.ts",
    "test:production-guards-integration": "jest --runInBand --forceExit tests/integration/production/db-probe-cli.integration.test.ts tests/integration/production/postflight-catalog.integration.test.ts tests/integration/production/run-predeploy-audit.integration.test.ts tests/integration/production/db-reconcile-readonly.integration.test.ts --testPathIgnorePatterns=/node_modules/ --globalSetup=./tests/integration/production/helpers/global-setup.cjs --globalTeardown=./tests/integration/production/helpers/global-teardown.cjs",
    "test:sale-transition-migration-consolidation": "jest --runInBand --forceExit tests/integration/migrations/update_instrument_sale_transition_atomic_consolidation.integration.test.ts --testPathIgnorePatterns=/node_modules/ --globalSetup=./tests/integration/migrations/helpers/global-setup.cjs --globalTeardown=./tests/integration/migrations/helpers/global-teardown.cjs",
    "test:financial-confidentiality-migration": "jest --runInBand --forceExit tests/integration/migrations/enforce_financial_confidentiality_db_boundary.integration.test.ts --testPathIgnorePatterns=/node_modules/ --globalSetup=./tests/integration/migrations/helpers/global-setup.cjs --globalTeardown=./tests/integration/migrations/helpers/global-teardown.cjs",
    "test:connection-relationship-uniqueness-migration": "jest --runInBand --forceExit tests/integration/migrations/enforce_unique_interested_booked_connections.integration.test.ts --testPathIgnorePatterns=/node_modules/ --globalSetup=./tests/integration/migrations/helpers/global-setup.cjs --globalTeardown=./tests/integration/migrations/helpers/global-teardown.cjs",
    "schema:ready": "tsx scripts/check-schema-readiness.ts",
    "format": "prettier --write .",
    "final": "npm run lint && npm run type-check && npm run test && npm run build",
    "deploy:build": "npm run schema:ready && npm run build",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:postgres": "tsx scripts/migrate.ts --postgres",
    "migrate:cli": "tsx scripts/migrate.ts --cli",
    "migrate:sh": "bash scripts/migrate.sh",
    "migrate:subtype": "tsx scripts/migrate-subtype.ts",
    "migrate:maintenance": "tsx scripts/migrate-maintenance-tasks.ts",
    "populate:numbers": "tsx scripts/populate-unique-numbers.ts",
    "fix:ownership": "tsx scripts/fix-ownership-uuids.ts",
    "reset:db": "tsx scripts/reset-database.ts",
    "seed:data": "tsx scripts/seed-demo-data.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "seed:demo:reset": "tsx scripts/seed-demo-data.ts --reset",
    "seed:demo:dry-run": "tsx scripts/seed-demo-data.ts --dry-run",
    "seed:demo:doctor": "tsx scripts/seed-demo-data.ts --doctor",
    "seed:demo:identity": "tsx scripts/seed-demo-data.ts --create-demo-identity",
    "auth:create-user": "tsx scripts/create-auth-user.ts",
    "schema:check": "tsx scripts/check-schema.ts",
    "schema:export": "tsx scripts/check-schema.ts",
    "check:middleware-manifest": "node scripts/check-middleware-manifest.cjs",
    "test:middleware-routing": "node scripts/verify-middleware-redirects.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-presigned-post": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.3.1",
    "@sentry/nextjs": "10.69.0",
    "@supabase/supabase-js": "^2.51.0",
    "@types/react-dnd": "^2.0.36",
    "@types/react-window": "^1.8.8",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "15.5.22",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-big-calendar": "^1.19.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.1.0",
    "react-window": "^2.2.1",
    "react-window-infinite-loader": "^2.0.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "15.5.22",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "4.22.5",
    "typescript": "^5",
    "whatwg-fetch": "^3.6.20"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "webpack-bundle-analyzer": {
      "ws": "7.5.13"
    },
    "@babel/core": "7.29.7",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "minimatch@9": "9.0.8",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}

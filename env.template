# =============================================================================
# HC Violins and Bows — environment template
# Copy to `.env.local` for local development. Production deploys are validated
# by `npm run check:env` (also invoked by `npm run deploy:build`).
#
# Use placeholders only. Never commit real credentials.
# Public keys may appear in the browser bundle. Server secrets must never use
# the NEXT_PUBLIC_ prefix.
# =============================================================================

# -----------------------------------------------------------------------------
# Required in production (public / client-safe)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Canonical application URL. Production must be https and must not be localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Required in production (server secrets / server runtime)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Durable object storage is required outside development/test.
# STORAGE_TYPE=local is development/test only.
STORAGE_TYPE=s3
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Rate limiting (Upstash). Required for ordinary production deploys.
# Missing URL/token fails `check:env` / `deploy:build` before next build.
# Runtime remains fail-closed if these are absent.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Required for POST /api/admin/orphan-cleanup (pg_cron / invocation auth).
ORPHAN_CLEANUP_SECRET=your_orphan_cleanup_secret

# -----------------------------------------------------------------------------
# Rate-limiting emergency override (not for ordinary production deploys)
# -----------------------------------------------------------------------------
# RATE_LIMITING_DISABLED=true disables rate limiting at runtime (fail-open).
# Ordinary production validation rejects that value.
# Emergency procedure (exceptional fail-open only):
#   1. Keep UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN configured.
#   2. Set RATE_LIMITING_DISABLED=true
#   3. Set ALLOW_UNSAFE_PRODUCTION_RATE_LIMITING_DISABLED=true
# Do not use this as a workaround for missing Upstash credentials.
# RATE_LIMITING_DISABLED=true
# ALLOW_UNSAFE_PRODUCTION_RATE_LIMITING_DISABLED=true

# -----------------------------------------------------------------------------
# Optional production configuration
# -----------------------------------------------------------------------------
# Server-side Supabase overrides. If set, they must match the NEXT_PUBLIC_* values.
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional S3 / storage
# AWS_ENDPOINT_URL=https://s3.amazonaws.com
# S3_ADDRESSING_STYLE=virtual-hosted-style
# KMS_KEY_ID=your_kms_key_id
UPLOAD_MAX_FILE_SIZE_MB=100
# STORAGE_BASE_PREFIX=uploads
# STORAGE_LOCAL_ROOT=/tmp/app-uploads

# HEALTH_CHECK_SECRET — unlocks detailed /api/health diagnostics in production.
#   Auth: Authorization: Bearer <exact-secret>
#   Without it in production, /api/health returns liveness-only {status,timestamp}.
#   Non-production may omit it and still get details.
# HEALTH_CHECK_SECRET=your_health_check_secret

# Optional for Next.js runtime. Used by SQL-backed health catalog diagnostics
# and by production migration tooling (separate workflow).
# DATABASE_URL=your_database_url
# DATABASE_PASSWORD=your_database_password

# Optional public display / branding
# NEXT_PUBLIC_APP_NAME=Instrument Inventory App
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_LOG_LEVEL=info
# NEXT_PUBLIC_STORE_NAME=HC Violins and Bows
# NEXT_PUBLIC_STORE_PHONE=
# NEXT_PUBLIC_STORE_EMAIL=
# NEXT_PUBLIC_STORE_ADDRESS=
# NEXT_PUBLIC_LOGO_URL=
# NEXT_PUBLIC_DEFAULT_SIGNER_NAME=
# NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=
# NEXT_PUBLIC_BANK_NAME=
# NEXT_PUBLIC_BANK_SWIFT=
# NEXT_PUBLIC_BANK_ACCOUNT=

# -----------------------------------------------------------------------------
# Optional Sentry (not required for production deploys)
# -----------------------------------------------------------------------------
# Public client DSN (browser). Server may also use SENTRY_DSN.
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_DSN=your_sentry_dsn
# Build-time source-map upload (server-only)
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_MIN_LEVEL=error

# -----------------------------------------------------------------------------
# Optional feature configuration
# -----------------------------------------------------------------------------
# Server-only error webhook (do not use NEXT_PUBLIC_ for the URL).
# ERROR_WEBHOOK_ENABLED=false
# ERROR_WEBHOOK_URL=https://your-webhook-url.example/errors
# ERROR_SEVERITY_THRESHOLD=HIGH

# Email notifications (feature-specific, not required for production deploys)
# RESEND_API_KEY=your_resend_api_key

# -----------------------------------------------------------------------------
# Local development
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# External CI / tooling (not validated by check:env)
# -----------------------------------------------------------------------------
# SNYK_TOKEN=your_snyk_token
# SONAR_TOKEN=your_sonarcloud_token
# VERCEL_TOKEN=your_vercel_token
# ORG_ID=your_vercel_org_id
# PROJECT_ID=your_vercel_project_id

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheE2ENamespace",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::STAGING_E2E_BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": "e2e/*"
        }
      }
    },
    {
      "Sid": "ReadWriteDeleteOnlyE2EObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::STAGING_E2E_BUCKET_NAME/e2e/*"
    }
  ]
}
